<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store build only. `make appstore` adds the application and team
	     identifiers for the team it signs with. Accessibility (moving other apps'
	     windows), Carbon hotkeys and SMAppService all work inside the sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
